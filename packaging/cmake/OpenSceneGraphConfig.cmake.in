# Config file for the OpenSceneGraph package.
#
#   find_package(OpenSceneGraph @OPENSCENEGRAPH_VERSION@ REQUIRED
#                COMPONENTS osgViewer osgDB CONFIG)
#   target_link_libraries(myapp PRIVATE @PKG_NAMESPACE@::osgViewer @PKG_NAMESPACE@::osgDB)
#
# Every library is an imported target named @PKG_NAMESPACE@::<name>. Include
# directories, the dependencies between OSG libraries, and -- for a static build
# -- the OSG_LIBRARY_STATIC define all travel with the target, so linking one is
# the whole of the integration. Debug and Release can share an install prefix;
# the target files below are per-configuration and CMake selects between them.
#
# COMPONENTS are checked against the targets that were actually built. Asking for
# a component that this install does not have fails the find_package rather than
# failing later at link time.
#
# ============================ DO NOT EDIT THE INSTALLED COPY ============================
# Generated from packaging/cmake/OpenSceneGraphConfig.cmake.in
# ========================================================================================

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The exported targets name these packages' imported targets, so the names have
# to exist again before the target file is included. Re-running the searches here
# rather than baking in the paths found on the build machine is what keeps the
# installed package relocatable.
#
# The searches need three settings that must not outlive them, so they run inside
# a block(). A scope that ends is more reliable here than saving and restoring by
# hand: find_dependency() calls return() when a dependency is missing, and that
# returns straight out of this file, skipping any restore written after the
# calls. A consumer whose find_package(OpenSceneGraph) was not REQUIRED would
# carry on with our search settings still applied. block() unwinds either way.
#
# PROPAGATE carries out the only two variables that have to survive, which
# find_dependency sets on exactly that failure path. It is load-bearing: without
# it a missing dependency is reported to the consumer as success.
#
# Imported targets and cache entries are not scoped variables, so every name
# OpenSceneGraphTargets.cmake needs still lands in the consumer's scope. What
# does not escape is the incidental result variables of these searches --
# ZLIB_FOUND, PNG_LIBRARIES and the like. A consumer who wants those calls
# find_package themselves and it resolves from cache; this package's interface
# is the imported targets.
block(SCOPE_FOR VARIABLES PROPAGATE OpenSceneGraph_FOUND OpenSceneGraph_NOT_FOUND_MESSAGE)

    if(NOT DEFINED OpenSceneGraph_PREFER_STATIC_DEPENDENCIES)
        set(OpenSceneGraph_PREFER_STATIC_DEPENDENCIES @OSG_CONFIG_STATIC_BUILD@)
    endif()
    if(OpenSceneGraph_PREFER_STATIC_DEPENDENCIES AND NOT WIN32)
        # .a first, but keep the rest of the list so dependencies that only ship
        # shared -- zlib on macOS is an SDK .tbd stub -- still resolve.
        list(INSERT CMAKE_FIND_LIBRARY_SUFFIXES 0 ".a")
    endif()

    # Windows has no library-suffix lever -- everything is .lib whether it is a
    # static library or an import library -- so the static preference has to be
    # expressed per package.
    #
    # Only set when the consumer has not decided for themselves.
    if(NOT DEFINED ZLIB_USE_STATIC_LIBS)
        set(ZLIB_USE_STATIC_LIBS @OSG_CONFIG_ZLIB_USE_STATIC_LIBS@)
    endif()

    # A few of the dependencies below have no find module in CMake itself, so
    # OpenSceneGraph installs its own beside this file and prepends that
    # directory for the duration of the searches.
    if(IS_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}/modules")
        list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/modules")
    endif()

@OSG_CONFIG_FIND_DEPENDENCY_CALLS@
endblock()

include("${CMAKE_CURRENT_LIST_DIR}/OpenSceneGraphTargets.cmake")

foreach(_osg_component IN LISTS OpenSceneGraph_FIND_COMPONENTS)
    if(TARGET @PKG_NAMESPACE@::${_osg_component})
        set(OpenSceneGraph_${_osg_component}_FOUND TRUE)
    else()
        set(OpenSceneGraph_${_osg_component}_FOUND FALSE)
    endif()
endforeach()
unset(_osg_component)

check_required_components(OpenSceneGraph)
